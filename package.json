{
  "name": "dsh-tavily-search-plugin",
  "version": "0.2.0",
  "description": "Tavily-backed (free) web search provider for the DeepSeek Harness web capability seam (ctx.web). Dual-face plugin: host registers the provider into the web seam and installs the settings namespace; client half contributes a settings card on the Settings → Plugins page.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/card-model.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "scripts/smoke-test.mjs",
    "scripts/client-render-test.mjs",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm run build && node scripts/smoke-test.mjs && node scripts/client-render-test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "check": "node --check src/index.ts 2>/dev/null; tsc --noEmit",
    "prepare": "tsdown"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "tavily",
    "web-search"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0"
  },
  "icon": "./icon.svg"
}
